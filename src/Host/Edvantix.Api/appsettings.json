{
  "Billing": {
    "DefaultPlanKey": "free",
    "GraceWindowDays": 7
  },
  "OpenTelemetryOptions": {
    "Enabled": true,
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true,
      "MeterNames": [ "FSH.Modules.Identity", "FSH.Modules.Multitenancy", "FSH.Modules.Auditing" ]
    },
    "Exporter": {
      "Otlp": {
        "Enabled": false,
        "Endpoint": "http://localhost:4317",
        "Protocol": "grpc"
      }
    },
    "Jobs": { "Enabled": true },
    "Mediator": { "Enabled": true },
    "Http": {
      "Histograms": {
        "Enabled": true
      }
    },
    "Data": {
      "FilterEfStatements": true,
      "FilterRedisCommands": true
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId", "WithProcessId", "WithProcessName" ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "DatabaseOptions": {
    "Provider": "POSTGRESQL",
    "ConnectionString": "Server=localhost;Database=fsh;User Id=postgres;Password=password;Minimum Pool Size=5",
    "MigrationsAssembly": "Edvantix.Migrations.PostgreSQL"
  },
  "OriginOptions": {
    "OriginUrl": "https://localhost:7030"
  },
  "CachingOptions": {
    "Redis": ""
  },
  "HangfireOptions": {
    "Username": "",
    "Password": "",
    "Route": "/jobs"
  },
  "PasswordPolicy": {
    "PasswordHistoryCount": 5,
    "PasswordExpiryDays": 90,
    "PasswordExpiryWarningDays": 14,
    "EnforcePasswordExpiry": true
  },
  "AllowedHosts": "*",
  "OpenApiOptions": {
    "Enabled": true,
    "Title": "Edvantix API",
    "Version": "v1",
    "Description": "The FSH Starter Kit API for Modular/Multitenant Architecture.",
    "Contact": {
      "Name": "Edvantix",
      "Url": "https://example.com",
      "Email": "noreply@example.com"
    },
    "License": {
      "Name": "MIT License",
      "Url": "https://opensource.org/licenses/MIT"
    }
  },
  "CorsOptions": {
    "AllowAll": false,
    "AllowedOrigins": [
      "https://localhost:4200",
      "https://localhost:7140"
    ],
    "AllowedHeaders": [ "content-type", "authorization" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE" ]
  },
  "JwtOptions": {
    "Issuer": "fsh.local",
    "Audience": "fsh.clients",
    "SigningKey": "",
    "AccessTokenMinutes": 45,
    "RefreshTokenDays": 7
  },
  "SecurityHeadersOptions": {
    "Enabled": true,
    "ExcludedPaths": [ "/scalar", "/openapi" ],
    "AllowInlineStyles": true,
    "ScriptSources": [],
    "StyleSources": []
  },
  "MailOptions": {
    "UseSendGrid": false,
    "From": "noreply@example.com",
    "DisplayName": "Edvantix",
    "SMTP": {
      "Host": "smtp.ethereal.email",
      "Port": 587,
      "UserName": "",
      "Password": ""
    },
    "SendGrid": {
      "ApiKey": "",
      "From": "noreply@example.com",
      "DisplayName": "FSH SendGrid"
    }
  },
  "RateLimitingOptions": {
    "Enabled": false,
    "Tenant": {
      "PermitLimit": 1000,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "User": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Ip": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Storage": {
    "Provider": "local"
  },
  "QuotaOptions": {
    "Enabled": true,
    "Redis": "",
    "DefaultPlan": "free",
    "ExemptRootTenant": true,
    "Plans": {
      "free": {
        "ApiCalls": 200000,
        "StorageBytes": 2147483648,
        "Users": 10,
        "ActiveFeatureFlags": 10,
        "ActiveStudents": 50,
        "ActiveTeachers": 5,
        "StudyGroups": 10,
        "MonthlySessions": 500
      },
      "pro": {
        "ApiCalls": 5000000,
        "StorageBytes": 53687091200,
        "Users": 200,
        "ActiveFeatureFlags": 100,
        "ActiveStudents": 1000,
        "ActiveTeachers": 100,
        "StudyGroups": 300,
        "MonthlySessions": 20000
      },
      "pro-annual": {
        "ApiCalls": 5000000,
        "StorageBytes": 53687091200,
        "Users": 200,
        "ActiveFeatureFlags": 100,
        "ActiveStudents": 1000,
        "ActiveTeachers": 100,
        "StudyGroups": 300,
        "MonthlySessions": 20000
      }
    }
  },
  "Files": {
    "UploadUrlTtlMinutes": 15,
    "DownloadUrlTtlMinutes": 60,
    "OrphanRetentionMinutes": 60,
    "SoftDeleteRetentionDays": 30,
    "Categories": {
      "Image":    { "AllowedExtensions": [".jpg",".jpeg",".png",".webp",".gif",".ico"], "MaxBytes": 10485760 },
      "Document": { "AllowedExtensions": [".pdf",".docx",".xlsx",".pptx",".txt",".csv"], "MaxBytes": 26214400 },
      "Archive":  { "AllowedExtensions": [".zip"], "MaxBytes": 52428800 },
      "LessonMaterial": {
        "AllowedExtensions": [".pdf",".doc",".docx",".ppt",".pptx",".xls",".xlsx",".txt",".csv",".rtf",".epub",".jpg",".jpeg",".png",".webp",".gif",".svg",".zip",".mp3",".m4a",".wav"],
        "MaxBytes": 26214400,
        "OwnerTypes": ["LessonMaterial"]
      }
    }
  },
  "Curriculum": {
    "VideoMaterialAllowedHosts": [ "youtube.com", "youtu.be", "vimeo.com", "rutube.ru", "vk.com", "vkvideo.ru", "dzen.ru" ]
  },
  "Auditing": {
    "Retention": {
      "Enabled": true,
      "ActivityRetentionDays": 30,
      "EntityChangeRetentionDays": 180,
      "SecurityRetentionDays": 730,
      "ExceptionRetentionDays": 180,
      "DeleteBatchSize": 5000,
      "Cron": "30 3 * * *"
    }
  }
}
